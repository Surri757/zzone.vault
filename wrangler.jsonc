{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zzone-vault",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    { "binding": "NS_FLOW", "id": "f133d35f199346bab3b99eeafd69edee" }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/lianmo/*", "!/lianmo", "!/lianmo/"]
  },
  "observability": {
    "enabled": true
  }
}
