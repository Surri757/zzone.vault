{
  "name": "private-trade-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "refresh:atlas": "node scripts/refresh-atlas.mjs",
    "test:atlas": "node --test lib/atlas-session.test.mjs",
    "refresh:catalog": "node scripts/refresh-stock-catalog.mjs",
    "sync:lianmo": "node scripts/sync-lianmo.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.1.2",
    "framer-motion": "^12.23.12",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.468.0",
    "next": "^15.4.4",
    "opentype.js": "^2.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@types/three": "^0.185.0",
    "autoprefixer": "^10.4.20",
    "d3-geo": "^3.1.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.4.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "topojson-client": "^3.1.0",
    "typescript": "^5.7.2",
    "world-atlas": "^2.0.2",
    "wrangler": "^4.118.0"
  }
}
